{
    "name": "pagelyne/admin",
    "description": "Reusable Pagelyne Admin Panel package",
    "type": "library",
    "license": "proprietary",
    "version": "1.0.0",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "laravel/framework": "^13.32"
    },
    "autoload": {
        "psr-4": {
            "Pagelyne\\Admin\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pagelyne\\Admin\\Providers\\AdminServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}